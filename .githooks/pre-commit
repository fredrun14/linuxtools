#!/usr/bin/env bash
# Hook pre-commit — bloque le commit si ruff, le gate de format, bandit, mypy ou
# pytest échouent.
#
# Versionné dans le dépôt (.githooks/). Activé via `core.hooksPath` par
# `make hooks` (voir Makefile) après tout clone.
#
# Périmètre : `make lint` + `make test-unit` (tests unitaires seulement) ;
# les tests d'intégration, `pip-audit` et le build sont joués par la CI
# Forgejo. Lance la suite unitaire complète plutôt que les seuls fichiers
# indexés. Contournement volontaire : `git commit --no-verify`.

set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

echo "→ ruff check"
uv run ruff check src/

echo "→ gate de format (make format-check)"
make format-check

echo "→ bandit"
uv run bandit -ll -r src/linuxtools/

echo "→ mypy (src + tests)"
uv run mypy src/linuxtools/ tests/

echo "→ pytest (unitaires)"
uv run pytest tests/unit/ -q

echo "OK — commit autorisé."
